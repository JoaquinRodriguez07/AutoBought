# Copy to .env and fill in new credentials. Never commit .env.
# Use the same local password here and in DATABASE_URL.
POSTGRES_PASSWORD=
# postgresql+psycopg2://ingsoft2:<URL-encoded-local-password>@postgres:5432/ingsoft2db
DATABASE_URL=
# postgresql+psycopg2://<user>:<URL-encoded-remote-password>@<host>:5432/<database>
REMOTE_DATABASE_URL=
