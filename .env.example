# Copiar a .env (en la raíz del repo) y completar. .env no se sube a Git.

# Perfil por defecto de docker compose: levanta solo lo local.
# Con --profile remoto en la línea de comandos, esta variable se ignora y levanta solo lo remoto.
COMPOSE_PROFILES=local

# Postgres local (docker compose up -d).
LOCAL_DB_HOST=postgres
LOCAL_DB_USER=ingsoft2
LOCAL_DB_PASSWORD=
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=ingsoft2db

# Clave para firmar los JWT del backend (obligatoria).
# Generar una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Postgres remoto: solo para el perfil remoto (docker compose --profile remoto up -d).
REMOTE_DB_HOST=
REMOTE_DB_USER=
REMOTE_DB_PASSWORD=
REMOTE_DB_PORT=5432
REMOTE_DB_NAME=ingsoft2db

# Mails. Si se dejan vacías, en local van a Mailpit: se ven en http://localhost:8025 y no se manda nada real.
# Para mandarlos de verdad con la cuenta de Gmail del equipo (contraseña de aplicación, nunca la de la cuenta):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=autobought.notificaciones@gmail.com
# SMTP_PASSWORD=
# EMAIL_FROM="AutoBought <autobought.notificaciones@gmail.com>"

# Dirección del frontend que usan los enlaces de los mails (por defecto http://localhost:5173).
# FRONTEND_URL=
