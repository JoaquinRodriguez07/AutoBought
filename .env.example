# Copiar a .env (en la raíz del repo) y completar. .env no se sube a Git.

# Perfil por defecto de docker compose: levanta solo lo local.
# Con --profile remoto en la línea de comandos, esta variable se ignora y levanta solo lo remoto.
COMPOSE_PROFILES=local

# Postgres local (docker compose up -d).
LOCAL_DB_HOST=postgres
LOCAL_DB_USER=ingsoft2
LOCAL_DB_PASSWORD=
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=ingsoft2db

# Clave para firmar los JWT del backend (obligatoria).
# Generar una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Postgres remoto: solo para el perfil remoto (docker compose --profile remoto up -d).
REMOTE_DB_HOST=
REMOTE_DB_USER=
REMOTE_DB_PASSWORD=
REMOTE_DB_PORT=5432
REMOTE_DB_NAME=ingsoft2db

# Mails. Si se dejan vacías, en local van a Mailpit: se ven en http://localhost:8025 y no se manda nada real.
# Para mandarlos de verdad con la cuenta de Gmail del equipo (contraseña de aplicación, nunca la de la cuenta):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=autobought.notificaciones@gmail.com
# SMTP_PASSWORD=
# EMAIL_FROM="AutoBought <autobought.notificaciones@gmail.com>"

# Dirección del frontend que usan los enlaces de los mails (por defecto http://localhost:5173).
# FRONTEND_URL=

# Inteligencia artificial (asistente de compra). Clave de Gemini (aistudio.google.com/apikey),
# con facturación activa. Sin clave, el asistente responde "no disponible" y se ofrece la búsqueda normal.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Consultas a la IA por usuario cada 24 horas.
# IA_LIMITE_DIARIO=20

# Mercado Pago (pago de los pedidos). Access Token de las credenciales de prueba
# (mercadopago.com.uy/developers > Tus integraciones). Sin token, no se puede pagar.
# MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de los webhooks: con ella se rechazan los avisos que no firmó Mercado Pago.
# MERCADOPAGO_WEBHOOK_SECRET=
# Dirección pública del backend, a la que Mercado Pago manda los avisos de pago
# (ej. https://autobought-api.onrender.com). En local queda vacía: no llegan avisos.
# BACKEND_URL=
# Minutos que tiene el cliente para pagar un pedido. Pasado el plazo, el pedido
# se cancela solo y el stock reservado vuelve al catálogo.
# MINUTOS_PARA_PAGAR=15

# Secreto con el que Vercel Cron llama a las tareas diarias (/api/v1/tareas/diarias).
# En Vercel se carga como variable de entorno del backend; en local no hace falta.
# Generar uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CRON_SECRET=
